# Local routing for the login gate. Readme.md section 8 M6.
#
# Each deployed app is reachable at <app>.localhost and must only ever be
# reachable through its sidecar, never directly. The sidecar listens on 8080
# and is the only thing this file is allowed to point at.
#
# Not wired to real apps yet; M6 fills in the per-app upstreams.

{
	auto_https off
}

:80 {
	respond "vibedeploy: no app matched this hostname" 404
}
