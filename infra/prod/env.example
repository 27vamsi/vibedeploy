# Copy to `infra/prod/.env` and fill in. Nothing here has a safe default, which
# is why there is a template rather than defaults in the compose file.
#
# Read twice, on purpose: once by `docker compose` for the `${...}` in
# docker-compose.yml, and once by each container as its environment. One file,
# so the paths the host mounts and the paths the processes are told about
# cannot disagree.
#
# Generate every secret below with:
#
#   openssl rand -hex 32
#
# and keep this file mode 0600. Four of the values in it are the whole security
# of the installation.

# ---------------------------------------------------------------------------
# Where things are on this host
# ---------------------------------------------------------------------------

# The checked-out repository. Mounted into our containers at **this same path**,
# because the worker hands paths under it to the host's Docker daemon as bind
# mounts and they have to mean the same thing on both sides of its filesystem.
# Do not change this to a path that only exists inside a container.
VD_ROOT=/opt/vibedeploy

# Per-app secrets, deployment checkouts and logs. Same rule: the app containers
# bind-mount a deployment's checkout from under here, so the path must be real
# on the host. Back this up — it holds every app's database credentials, and
# they are encrypted with VD_SECRET_KEY below, which means losing either one
# loses both.
#
# All three of our processes run as uid 10000 and all three write in here, so
# create it before the first `up`:
#
#   sudo mkdir -p /var/lib/vibedeploy && sudo chown -R 10000:10000 /var/lib/vibedeploy
VD_STATE_ROOT=/var/lib/vibedeploy

# The gid of the host's `docker` group, which is what lets the worker reach the
# socket without being root — and therefore without leaving root-owned files in
# the state root for the other two processes to trip over:
#
#   getent group docker | cut -d: -f3
VD_DOCKER_GID=999

# ---------------------------------------------------------------------------
# Which installation this is
# ---------------------------------------------------------------------------

# Turns every convenience default in `control_plane/config.py` into a refusal
# to start. Without this line the stack comes up using a Postgres password that
# is in the repository. It is the first thing to set and the last thing to
# remove.
VD_ENV=prod

# The control plane runs `alembic upgrade head` on startup, under a Postgres
# advisory lock so that two containers coming up together cannot race into a
# crash loop. Only the control plane honours this; the worker never migrates.
VD_MIGRATE_ON_BOOT=1

# Decides three things at once, so it cannot be set half way: the session
# cookie is marked `Secure`, an app's login cookie is too, and the route table
# the worker writes into Caddy listens on 443 — which is what makes Caddy get a
# certificate for a newly deployed app. Set it before the first deploy.
VD_PUBLIC_SCHEME=https

# Two containers per generation, sharing one network namespace that the login
# gate owns. The default, and the only runtime there will be once the bare
# process one is deleted.
VD_RUNTIME=apprt

# ---------------------------------------------------------------------------
# Names on the internet
# ---------------------------------------------------------------------------

# Apps are published at `<subdomain>.${VD_APP_DOMAIN}`, so this needs a
# wildcard A record (`*.apps.example.com`) pointing at this host. Caddy gets a
# certificate per app, when that app's route is written.
VD_APP_DOMAIN=apps.example.com
VD_APP_PORT=443

# The console's own hostname, routed through the same Caddy as the apps because
# two servers cannot share 443. Needs its own A record. Leave it empty and the
# console has no public address at all — which is a defensible way to run this,
# reached over an SSH tunnel to port 8100 instead.
VD_CONSOLE_DOMAIN=console.example.com

# Where Let's Encrypt sends expiry warnings. An ACME account with no contact is
# how a renewal failure becomes an outage nobody was told about.
VD_ACME_EMAIL=ops@example.com

# ---------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------

VD_PG_USER=vd_admin
VD_PG_PASSWORD=CHANGE-ME-openssl-rand-hex-32

# The control plane's own tables: apps, deployments, access models, the job
# queue. Must match VD_PG_USER/VD_PG_PASSWORD above.
VD_CONTROL_DATABASE_URL=postgresql+asyncpg://vd_admin:CHANGE-ME-openssl-rand-hex-32@postgres:5432/vibedeploy_control

# The customer database, where every app gets a schema and its four roles. An
# app's own DSN is derived from this one, so the host here is the host an app
# connects to.
VD_APP_ADMIN_DSN=postgresql://vd_admin:CHANGE-ME-openssl-rand-hex-32@postgres:5432/vibedeploy

# The throwaway instance the build job is let loose in. A different password
# from the two above is not pedantry: this is the one credential that is handed
# to a container running code we have never read.
VD_BUILD_PG_USER=vd_admin
VD_BUILD_PG_PASSWORD=CHANGE-ME-A-DIFFERENT-SECRET
VD_BUILD_DATABASE_URL=postgresql://vd_admin:CHANGE-ME-A-DIFFERENT-SECRET@buildpg:5432/vibedeploy_build

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# What console session cookies are signed with. There is no "unsigned" mode: an
# empty value here makes every session forgeable, which is the same thing as
# having no login, so the control plane refuses to start without it.
VD_SESSION_SECRET=CHANGE-ME-openssl-rand-hex-32

# What every app secret in VD_STATE_ROOT is encrypted with. **Must not change
# between restarts** — change it and every stored database credential becomes
# unreadable and every app's next deploy fails. `VD_SECRET_KEY_FILE` is offered
# instead if you would rather it not be in a process listing or a `docker
# inspect`.
VD_SECRET_KEY=CHANGE-ME-openssl-rand-hex-32

# How a login gate authenticates itself to the control plane when it asks who a
# cookie belongs to.
VD_SIDECAR_API_KEY=CHANGE-ME-openssl-rand-hex-32

# The one key the console may talk to the gateway with. The console holds no
# app credentials, so approving an agent action means asking the gateway to
# redo the dry run rather than reaching for the secret itself.
VD_GATEWAY_API_KEY=CHANGE-ME-openssl-rand-hex-32

# What GitHub signs push deliveries with. `/hooks/github` is the one endpoint a
# stranger can reach; empty is not "unchecked", it is "nobody gets in", and in
# prod it is required rather than empty. Paste the same value into the
# webhook's Secret field on GitHub.
VD_GITHUB_WEBHOOK_SECRET=CHANGE-ME-openssl-rand-hex-32

# The first operator, created on boot if this installation has none. Set these:
# without them a fresh box serves a one-time setup page, and on a public
# address the first stranger to find it becomes the operator. Ignored once a
# builder exists, so it is not a standing password reset either.
VD_BOOTSTRAP_EMAIL=you@example.com
VD_BOOTSTRAP_PASSWORD=CHANGE-ME-and-then-change-it-in-the-console

# ---------------------------------------------------------------------------
# How our processes find each other
# ---------------------------------------------------------------------------
#
# Compose service names, not loopback. Inside a container `127.0.0.1` is that
# container, and these addresses are dialled from four different ones: the
# control plane, the worker, the build job and every app's login gate.

VD_CONTROL_PLANE_URL=http://control-plane:8100
VD_GATEWAY_URL=http://gateway:8200

# Can rewrite the entire proxy configuration, which is why it is a name on the
# compose network and is not published to the host in docker-compose.yml.
VD_PROXY_ADMIN_URL=http://caddy:2019

# The network an app's login gate joins, so that Caddy can reach it by
# container name. It is the compose project's default network, and the project
# name decides what that is called — change `name:` in docker-compose.yml and
# this has to follow.
VD_APP_NETWORK=vibedeploy_default

# The network the build job gets. Separate from the one above on purpose: that
# one decides who can reach an app, this one decides what an app's own
# untrusted migrations can reach. It is the same network here only because the
# throwaway database has a name on it and nothing else the build job could
# reach is worth anything to it.
VD_BUILD_NETWORK=vibedeploy_default

# Only needed if some address above is still a loopback one. `host.docker.
# internal` is a Docker Desktop property, not a Docker one: on a Linux box a
# loopback-bound port is not reachable from the bridge gateway, so the right
# fix is a service name, and this variable is the escape hatch for an address
# that cannot have one.
# VD_CONTAINER_HOST=
